#!/bin/bash
# Add the primary human user (UID 1000, created by the installer) to the
# libvirt group so virsh/virt-install can manage qemu://system VMs without sudo. Idempotent; runs every boot.
set -eu
user=$(getent passwd 1000 | cut -d: -f1 || true)
[ -n "$user" ] || exit 0
getent group libvirt >/dev/null || exit 0
if id -nG "$user" | tr ' ' '\n' | grep -qx libvirt; then
    exit 0
fi
usermod -aG libvirt "$user"
echo "added $user to the libvirt group (log out and back in to apply)"
